    m_Metadata:
      m_Items: []
  - m_Id: 34065173667840
    m_Localized: "\u041F\u0443\u043B\u0435\u043C\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 34214050488320
    m_Localized: "\u041C\u0438\u043D\u0438\u0433\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 34273265672192
    m_Localized: "\u0420\u041F\u0413"
    m_Metadata:
      m_Items: []
  - m_Id: 707139738787840
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 837296118030336
    m_Localized: "\u041E\u0433\u043E, \u0443 \u043C\u0435\u043D\u044F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0435\u0441\u0442\u044C <color=#FFD54F>\u041E\u0420\u0423\u0416\u0418\u0415!</color>\n\u0416\u043C\u0438
      \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 <color=#55D6FF>\u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F</color>\n\u0438
      \u043F\u043E\u043A\u0430\u0436\u0438 \u0432\u0440\u0430\u0433\u0430\u043C,
      \u043D\u0430 \u0447\u0442\u043E \u044F \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 839118824136704
    m_Localized: "<color=#69F0AE>\u0423\u0420\u0410\u0410\u0410!</color> \u041D\u043E\u0432\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C!\n\u042F \u0441\u0442\u0430\u043B
      <color=#FFD54F>\u0421\u0418\u041B\u042C\u041D\u0415\u0415</color>, \u0430 \u0437\u0430\u043F\u0430\u0441
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0432\u044B\u0440\u043E\u0441!\n\u041D\u0443
      \u0432\u0441\u0451, \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 839156904222720
    m_Localized: "<color=#59FF56>\u041D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C</color>\t\t\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      <color=#FF383A>\u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F</color> \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 839716055277568
    m_Localized: "\u0412\u0430\u0443! \u041A\u0430\u043A\u0438\u0435 <color=#FFD54F>\u041A\u0423\u0411\u041A\u0418!</color>  
      <sprite name=\"Cup\">\n\u0411\u0443\u0434\u0443 \u0438\u0445 \u043A\u043E\u043F\u0438\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C\n<color=#55D6FF>\u041D\u041E\u0412\u041E\u0415
      \u041E\u0420\u0423\u0416\u0418\u0415!</color>\n\u0425\u043E\u0447\u0443 \u043F\u0443\u0448\u043A\u0443
      \u043F\u043E\u043A\u0440\u0443\u0447\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 839856627376128
    m_Localized: "\u041A\u043B\u0430\u0441\u0441! \u0417\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\n\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u044E
      <color=#FFD54F>\u041E\u0427\u041A\u0418!</color>   <sprite name=\"Score\">\n\u0427\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u044E,\n\u0442\u0435\u043C
      \u0431\u043B\u0438\u0436\u0435 <color=#69F0AE>\u041D\u041E\u0412\u042B\u0419
      \u0423\u0420\u041E\u0412\u0415\u041D\u042C!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 840990880423936
    m_Localized: "\u0419\u0435\u0441! <color=#FFD54F>\u041A\u041E\u0420\u041E\u041D\u042B!</color>
      <sprite name=\"Crown\">\n\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u044E
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F,
      \u0441\u043E\u0431\u0438\u0440\u0430\u044E \u043A\u043E\u0440\u043E\u043D\u044B
      \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0441\u044C <color=#55D6FF>\u0412
      \u0422\u0410\u0411\u041B\u0418\u0426\u0415 \u041B\u0418\u0414\u0415\u0420\u041E\u0412!</color>\n\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430!"
    m_Metadata:
      m_Items: []
